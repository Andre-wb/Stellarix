{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellarix",
  "version": "0.1.0",
  "identifier": "com.stellarix.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stellarix",
        "url": "index.html",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://127.0.0.1:8000; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://127.0.0.1:8000 http://localhost:8000;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../static"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}